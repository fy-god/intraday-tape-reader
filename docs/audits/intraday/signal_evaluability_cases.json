  "blocking_vs_advisory_semantics": {
    "_finding": "IT-P1-CAPABILITY-003 的语义混淆部分",
    "volume_burst": {
      "turnover": {
        "state": "BLOCKING",
        "trigger": "min_turnover > 0 且 ctx.provides('turnover') 为假",
        "mechanism": "q.turnover 读到占位 0.0，必然 < min_turnover，该票在门槛处 continue，判据不完整",
        "effect": "进 blocked_capability / unavailable_codes，进 considered 分母但不进 evaluable",
        "test": "tests/test_signal_evaluability_teeth.py::test_turnover_missing_still_counted_unavailable"
      },
      "volume_ratio": {
        "state": "ADVISORY",
        "trigger": "vr_thr > 0 且 ctx.provides('volume_ratio') 为假",
        "mechanism": "vr 读到占位 0.0，vr > vr_thr 为假 → 量比门槛被**跳过**，速度/金额条件仍生效，规则仍可命中",
        "effect": "只加 advisory_missing，**不进** unavailable_codes；该票仍进 evaluable",
        "test": "tests/test_signal_evaluability_teeth.py::test_advisory_missing_is_not_counted_as_capability_unavailable",
        "_verified_by": "同一票在缺 volume_ratio 时实测产出 1 条 alert（不是 0）"
      }
    }
  },

  "new_ledger_fields": {
    "_source": "src/arad/capabilities.py SignalEvalStats",
    "fields": ["considered", "evaluable", "blocked_capability", "advisory_missing",
               "evaluated_no_hit", "hit_candidates", "published",
               "blocked_reasons", "blocked_sample"],
    "derived": {
      "evaluable_coverage": "evaluable / considered；considered <= 0 时返回 None（not_measured），**不是** 0.0"
    },
    "mechanical_invariants": [
      "evaluable + blocked_capability == considered",
      "evaluated_no_hit + hit_candidates == evaluable",
      "published <= hit_candidates",
      "advisory_missing <= evaluable"
    ],
    "enforced_by": "RoundObservationSet.check_signal_invariants() -> list[str]"
  },

